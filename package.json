{
  "name": "@astynomus/discord-mcp",
  "version": "0.1.0",
  "description": "Familiar — self-hosted Discord MCP server",
  "license": "AGPL-3.0-only",
  "type": "module",
  "bin": {
    "discord-mcp": "dist/main.js"
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run build && npm run lint && npm run test && npm run format:check",
    "prepack": "npm run build",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "discord.js": "^14.27.0",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astynomus-LLC/familiar.git"
  },
  "homepage": "https://github.com/Astynomus-LLC/familiar#readme",
  "author": "Astynomus LLC"
}
